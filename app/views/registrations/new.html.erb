<section class="auth-panel">
  <h1>Create your account</h1>

  <%= render "shared/form_errors", record: @user %>

  <%= form_with model: @user, url: registration_path, class: "stacked-form" do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Create account", class: "button primary" %>
  <% end %>

  <p class="auth-link">
    Already have an account?
    <%= link_to "Sign in", new_session_path %>
  </p>
</section>
