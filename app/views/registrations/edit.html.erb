<section class="page-header">
  <div>
    <p class="eyebrow">Account</p>
    <h1>Edit profile</h1>
  </div>
</section>

<section class="form-panel">
  <%= render "shared/form_errors", record: @user %>

  <%= form_with model: @user, url: registration_path, method: :patch, class: "stacked-form" do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username" %>
    </div>

    <hr>

    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, autocomplete: "new-password", maxlength: 72 %>
      <small>Leave blank to keep your current password.</small>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <%= form.submit "Save changes", class: "button primary" %>
  <% end %>
</section>
