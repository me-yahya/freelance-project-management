<section class="page-header">
  <div>
    <p class="eyebrow">Task</p>
    <h1><%= @task.title %></h1>
  </div>

  <div class="page-actions">
    <% unless @task.completed? %>
      <%= button_to "Complete", complete_task_path(@task), method: :patch, class: "button" %>
    <% end %>
    <%= link_to "Edit", edit_task_path(@task), class: "button" %>
    <%= button_to "Delete", @task, method: :delete, class: "button danger", data: { turbo_confirm: "Delete this task?" } %>
  </div>
</section>

<section class="details-panel">
  <dl>
    <div>
      <dt>Project</dt>
      <dd><%= link_to @task.project.name, @task.project %></dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd><%= status_badge(@task) %></dd>
    </div>
    <div>
      <dt>Priority</dt>
      <dd><%= priority_badge(@task) %></dd>
    </div>
    <div>
      <dt>Due date</dt>
      <dd><%= @task.due_date || "-" %></dd>
    </div>
    <div>
      <dt>Description</dt>
      <dd><%= simple_format(@task.description.presence || "-") %></dd>
    </div>
  </dl>
</section>

<%= link_to "Back to tasks", tasks_path %>
