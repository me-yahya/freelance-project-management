<section class="page-header">
  <div>
    <p class="eyebrow">Tasks</p>
    <h1>Your tasks</h1>
  </div>

  <%= link_to "New task", new_task_path, class: "button primary" %>
</section>

<section class="toolbar">
  <%= form_with url: tasks_path, method: :get, class: "search-form filters-form" do |form| %>
    <%= form.label :query, "Search tasks", class: "sr-only" %>
    <%= form.search_field :query, value: @query, placeholder: "Search by title or description" %>
    <%= form.select :status, options_for_select([ [ "All", "" ] ] + Task.status_options, @status) %>
    <%= form.select :priority, options_for_select([ [ "All priorities", "" ] ] + Task.priority_options, @priority) %>
    <%= form.submit "Filter", class: "button" %>
    <% if @query.present? || @status.present? || @priority.present? %>
      <%= link_to "Clear", tasks_path %>
    <% end %>
  <% end %>
</section>

<% if @tasks.any? %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Task</th>
          <th>Project</th>
          <th>Status</th>
          <th>Priority</th>
          <th>Due</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @tasks.each do |task| %>
          <tr>
            <td><%= link_to task.title, task %></td>
            <td><%= link_to task.project.name, task.project %></td>
            <td><%= status_badge(task) %></td>
            <td><%= priority_badge(task) %></td>
            <td><%= task.due_date || "-" %></td>
            <td class="actions">
              <% unless task.completed? %>
                <%= button_to "Complete", complete_task_path(task), method: :patch, class: "link-button" %>
              <% end %>
              <%= link_to "Edit", edit_task_path(task) %>
              <%= button_to "Delete", task, method: :delete, class: "link-button danger", data: { turbo_confirm: "Delete this task?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <section class="empty-state">
    <h2>No tasks found</h2>
    <p>Create tasks after creating a project.</p>
    <%= link_to "New task", new_task_path, class: "button primary" %>
  </section>
<% end %>
