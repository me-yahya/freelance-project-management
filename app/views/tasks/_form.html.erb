<%= render "shared/form_errors", record: task %>

<%= form_with model: task, class: "stacked-form" do |form| %>
  <div class="field">
    <%= form.label :project_id, "Project" %>
    <%= form.collection_select :project_id, @projects, :id, :name, { prompt: "Choose a project" }, required: true %>
  </div>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, autofocus: true %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <div class="two-column-fields">
    <div class="field">
      <%= form.label :due_date %>
      <%= form.date_field :due_date %>
    </div>

    <div class="field">
      <%= form.label :priority %>
      <%= form.select :priority, Task.priority_options %>
    </div>
  </div>

  <div class="field">
    <%= form.label :status %>
    <%= form.select :status, Task.status_options %>
  </div>

  <div class="form-actions">
    <%= form.submit task.persisted? ? "Update task" : "Create task", class: "button primary" %>
    <%= link_to "Cancel", task.persisted? ? task_path(task) : tasks_path %>
  </div>
<% end %>
